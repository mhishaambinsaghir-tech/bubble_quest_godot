[gd_scene load_steps=3 format=3 uid="uid://b7bhsrrvqb2q0"]

[ext_resource type="Texture2D" uid="uid://ny273q7jji8e" path="res://assets/backgrounds/levels_select_world1_bg.jpg" id="1_bg"]

[sub_resource type="GDScript" id="GDScript_level_select"]
script/source = "extends Control

const WORLD_BACKGROUNDS: Array[String] = [
	\"res://assets/backgrounds/levels_select_world1_bg.jpg\",
	\"res://assets/backgrounds/levels_select_world2_bg.jpg\",
	\"res://assets/backgrounds/levels_select_world3_bg.jpg\",
	\"res://assets/backgrounds/levels_select_world4_bg.jpg\"
]

const TOTAL_WORLDS: int = 4
const LEVELS_PER_WORLD: int = 50

var current_world_index: int = 0
var highest_unlocked_level: int = 0
var best_scores: Dictionary = {}

func _ready() -> void:
	var gm = load(\"res://scripts/game_manager.gd\")
	if gm != null:
		gm.load_save_data()
		highest_unlocked_level = gm.highest_unlocked_level
		best_scores = gm.best_scores

	current_world_index = clampi(highest_unlocked_level / LEVELS_PER_WORLD, 0, TOTAL_WORLDS - 1)

	var prev_btn = get_node_or_null(\"MobileViewport/CenterContainer/VBoxContainer/WorldNavContainer/PrevWorldButton\")
	var next_btn = get_node_or_null(\"MobileViewport/CenterContainer/VBoxContainer/WorldNavContainer/NextWorldButton\")
	var back_btn = get_node_or_null(\"MobileViewport/CenterContainer/VBoxContainer/BackButton\")

	if prev_btn != null:
		setup_button(prev_btn)
		prev_btn.pressed.connect(_on_prev_world_pressed)

	if next_btn != null:
		setup_button(next_btn)
		next_btn.pressed.connect(_on_next_world_pressed)

	if back_btn != null:
		setup_button(back_btn)
		back_btn.pressed.connect(_on_back_pressed)

	render_current_world()

func render_current_world() -> void:
	var bg_rect = get_node_or_null(\"MobileViewport/Background\")
	if bg_rect != null:
		var bg_path = WORLD_BACKGROUNDS[current_world_index]
		if ResourceLoader.exists(bg_path):
			bg_rect.texture = load(bg_path)
		else:
			bg_rect.texture = load(WORLD_BACKGROUNDS[0])

	var world_label = get_node_or_null(\"MobileViewport/CenterContainer/VBoxContainer/WorldNavContainer/WorldTitleLabel\")
	if world_label != null:
		world_label.text = \"WORLD \" + str(current_world_index + 1)

	var prev_btn = get_node_or_null(\"MobileViewport/CenterContainer/VBoxContainer/WorldNavContainer/PrevWorldButton\")
	var next_btn = get_node_or_null(\"MobileViewport/CenterContainer/VBoxContainer/WorldNavContainer/NextWorldButton\")

	if prev_btn != null:
		prev_btn.disabled = (current_world_index <= 0)

	if next_btn != null:
		next_btn.disabled = (current_world_index >= TOTAL_WORLDS - 1)

	var level_grid = get_node_or_null(\"MobileViewport/CenterContainer/VBoxContainer/LevelGrid\")
	if level_grid != null:
		var base_level_idx: int = current_world_index * LEVELS_PER_WORLD
		for slot_idx in range(LEVELS_PER_WORLD):
			var btn = level_grid.get_node_or_null(\"Level\" + str(slot_idx + 1) + \"Button\")
			if btn == null:
				continue

			var abs_level_idx: int = base_level_idx + slot_idx
			var abs_level_num: int = abs_level_idx + 1
			var is_unlocked: bool = (abs_level_idx <= highest_unlocked_level)

			var connections = btn.pressed.get_connections()
			for conn in connections:
				btn.pressed.disconnect(conn.callable)

			if is_unlocked:
				btn.disabled = false
				setup_button(btn)
				var str_idx = str(abs_level_idx)
				if best_scores.has(str_idx):
					btn.text = str(abs_level_num) + \"\\n★ \" + str(best_scores[str_idx])
				else:
					btn.text = str(abs_level_num)
				var target_idx = abs_level_idx
				btn.pressed.connect(func(): _on_level_selected(target_idx))
			else:
				btn.disabled = true
				btn.text = str(abs_level_num) + \"\\n🔒\"

func setup_button(btn: Button) -> void:
	if btn == null: return
	btn.pivot_offset = btn.size / 2.0
	if not btn.resized.is_connected(_on_btn_resized.bind(btn)):
		btn.resized.connect(_on_btn_resized.bind(btn))

func _on_btn_resized(btn: Button) -> void:
	if btn != null:
		btn.pivot_offset = btn.size / 2.0

func _on_prev_world_pressed() -> void:
	if current_world_index > 0:
		current_world_index -= 1
		render_current_world()

func _on_next_world_pressed() -> void:
	if current_world_index < TOTAL_WORLDS - 1:
		current_world_index += 1
		render_current_world()

func _on_level_selected(idx: int) -> void:
	var gm = load(\"res://scripts/game_manager.gd\")
	if gm != null:
		gm.selected_level_index = idx
	get_tree().change_scene_to_file(\"res://scenes/gameplay/Scene_Gameplay.tscn\")

func _on_back_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scenes/ui/main_menu.tscn\")
"

